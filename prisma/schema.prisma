generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
}

// --- ENUMS ---
enum Role {
  CUSTOMER
  ADMIN
  TECHNICIAN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ON_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// --- MODELS ---

model User {
  id            String    @id @default(cuid())
  full_name     String
  email         String    @unique
  password      String
  phone_number  String?
  address       String?
  province      String?
  city          String?
  id_number     String?   
  id_photo      String?
  specialities  String?   
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  bookings      Booking[] @relation("UserBookings")
  assignedTasks Booking[] @relation("ProviderTasks")
}

model Category {
  id            String    @id @default(cuid())
  category_name String    @unique
  services      Services[]
}

model Services {
  id            String    @id @default(cuid())
  services_name String
  price         Float
  category_id   String
  category      Category  @relation(fields: [category_id], references: [id])
  bookings      Booking[]
  variants      ServiceVariant[]
}

model ServiceVariant {
  id           String   @id @default(cuid())
  variant_name String   
  price        Float
  service_id   String
  service      Services @relation(fields: [service_id], references: [id], onDelete: Cascade)
}

model Booking {
  id            String        @id @default(cuid())
  status        BookingStatus @default(PENDING)
  schedule      DateTime      
  total_price   Float
  address       String?
  province      String?
  city          String?
  user_id       String
  user          User          @relation("UserBookings", fields: [user_id], references: [id])
  services_id   String
  services      Services      @relation(fields: [services_id], references: [id])
  provider_id   String?
  provider      User?         @relation("ProviderTasks", fields: [provider_id], references: [id])
  payment       Payment?
}

model Payment {
  id            String        @id @default(cuid())
  method        String        
  status        PaymentStatus @default(PENDING)
  amount_to_pay Float
  booking_id    String        @unique
  booking       Booking       @relation(fields: [booking_id], references: [id])
}